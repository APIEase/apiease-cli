      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_BOOTSTRAP_SYNCHRONIZED_NO_RESOURCES"},
        "result": {"$ref": "#/$defs/artifactPackage"}
