      "required": ["createCount", "deleteCount", "noChangeCount", "operationCount", "updateCount"],
      "properties": {
        "createCount": {"type": "integer", "minimum": 0, "maximum": 1000},
        "deleteCount": {"type": "integer", "minimum": 0, "maximum": 1000},
