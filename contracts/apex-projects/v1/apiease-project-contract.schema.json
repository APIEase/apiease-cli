{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apiease.com/contracts/apex-projects/v1/apiease-project-contract.schema.json",
  "title": "APIEase Project Design contracts, version 1",
  "$defs": {
    "contractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applyReceiptContractVersion", "canonicalResourceChangeSetContractVersion", "designContextContractVersion", "projectApiContractVersion", "projectChangeArtifactContractVersion", "projectProposalContractVersion", "resourceApiContractVersion"],
      "properties": {
        "applyReceiptContractVersion": {"const": 1},
        "canonicalResourceChangeSetContractVersion": {"const": 1},
        "designContextContractVersion": {"const": 1},
        "projectApiContractVersion": {"const": 1},
        "projectChangeArtifactContractVersion": {"const": 1},
        "projectProposalContractVersion": {"const": 1},
        "resourceApiContractVersion": {"const": 1}
      }
    },
    "identity": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,1023}$"},
    "handle": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "resourceVersion": {"type": "string", "pattern": "^rv1_[A-Za-z0-9_-]{43}$"},
    "resourceType": {"enum": ["function", "request", "variable", "widget"]},
    "resourceErrorString": {"type": "string", "minLength": 1, "maxLength": 256},
    "resourceFieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "message"],
      "properties": {
        "path": {"$ref": "#/$defs/resourceErrorString"},
        "code": {"$ref": "#/$defs/resourceErrorString"},
        "message": {"$ref": "#/$defs/resourceErrorString"}
      }
    },
    "resourceValidationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"$ref": "#/$defs/resourceErrorString"},
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "handle": {"$ref": "#/$defs/resourceErrorString"},
        "path": {"$ref": "#/$defs/resourceErrorString"},
        "fieldPath": {"$ref": "#/$defs/resourceErrorString"},
        "explanation": {"type": "string", "maxLength": 256},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "sourceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "operationIndex": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "dependencyResourceType": {"$ref": "#/$defs/resourceType"},
        "dependencyHandle": {"$ref": "#/$defs/resourceErrorString"}
      }
    },
    "resourceValidationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "error"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": false},
        "outcome": {"const": "RESOURCE_VALIDATION_FAILED"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "fieldErrors"],
          "properties": {
            "code": {"const": "RESOURCE_VALIDATION_FAILED"},
            "message": {"const": "The resource is invalid."},
            "fieldErrors": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/resourceFieldError"}},
            "diagnostics": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/resourceValidationDiagnostic"}}
          }
        }
      }
    },
    "operationKey": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^.*\\S.*$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveRevision", "snapshotDigest"],
      "properties": {
        "liveRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "snapshotDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "canonicalResourceSource": {"$ref": "https://apiease.com/contracts/project-design/v1/schemas/canonical-resource-source.schema.json"},
    "verifiedResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "resourceType", "handle", "resourceId", "expectedResourceVersion"],
      "properties": {
        "bindingId": {"$ref": "#/$defs/identity"},
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "resourceId": {"$ref": "#/$defs/identity"},
        "expectedResourceVersion": {"$ref": "#/$defs/resourceVersion"}
      }
    },
    "resourceCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "source"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "source": {"$ref": "#/$defs/canonicalResourceSource"}
      }
    },
    "resourceUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "bindingId", "source"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "bindingId": {"$ref": "#/$defs/identity"},
        "source": {"$ref": "#/$defs/canonicalResourceSource"}
      }
    },
    "resourceDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "bindingId"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "bindingId": {"$ref": "#/$defs/identity"}
      }
    },
    "protectedFieldPath": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?:value|parameters\\.[^.]+\\.value)$"},
    "secureInputInstruction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceType", "handle", "fieldPath", "mode"],
          "properties": {
            "resourceType": {"enum": ["request", "variable"]},
            "handle": {"$ref": "#/$defs/handle"},
            "fieldPath": {"$ref": "#/$defs/protectedFieldPath"},
            "mode": {"enum": ["defer", "preserve"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceType", "handle", "fieldPath", "mode", "inputSelector"],
          "properties": {
            "resourceType": {"enum": ["request", "variable"]},
            "handle": {"$ref": "#/$defs/handle"},
            "fieldPath": {"$ref": "#/$defs/protectedFieldPath"},
            "mode": {"const": "replace"},
            "inputSelector": {"$ref": "#/$defs/identity"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceType", "handle", "fieldPath", "mode", "sourceBindingId", "sourceFieldPath"],
          "properties": {
            "resourceType": {"enum": ["request", "variable"]},
            "handle": {"$ref": "#/$defs/handle"},
            "fieldPath": {"$ref": "#/$defs/protectedFieldPath"},
            "mode": {"const": "reference"},
            "sourceBindingId": {"$ref": "#/$defs/identity"},
            "sourceFieldPath": {"$ref": "#/$defs/protectedFieldPath"}
          }
        }
      ]
    },
    "canonicalResourceChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "changeSetId", "changeSetDigest", "baseline", "creates", "updates", "deletes", "secureInputs", "verifiedBindings"],
      "properties": {
        "contractVersion": {"const": 1},
        "changeSetId": {"$ref": "#/$defs/identity"},
        "changeSetDigest": {"$ref": "#/$defs/digest"},
        "baseline": {"$ref": "#/$defs/baseline"},
        "creates": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/resourceCreate"}},
        "updates": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/resourceUpdate"}},
        "deletes": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/resourceDelete"}},
        "secureInputs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/secureInputInstruction"}},
        "verifiedBindings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/verifiedResourceBinding"}}
      }
    },
    "projectDesignRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "projectDesignRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectName",
        "customerRequirements",
        "confirmedDecisions"
      ],
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "customerRequirements": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/projectDesignRequirement"
          }
        },
        "confirmedDecisions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      }
    },
    "projectDesignContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "designContextContractVersion",
        "projectId"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "designContextContractVersion": {
          "const": 1
        },
        "projectId": {
          "$ref": "#/$defs/identity"
        },
        "projectRequirements": {
          "$ref": "#/$defs/projectDesignRequirements"
        }
      }
    },
    "projectDesignProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "commonInstructions",
        "commonInstructionDigest",
        "codexEnvelope"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0.0"
        },
        "commonInstructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "commonInstructionDigest": {
          "$ref": "#/$defs/digest"
        },
        "codexEnvelope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        }
      }
    },
    "projectDesignIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizedShopDomain",
        "projectId"
      ],
      "properties": {
        "normalizedShopDomain": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.myshopify\\.com$"
        },
        "projectId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "projectDesignSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectIdentity",
        "liveRevision",
        "snapshotDigest"
      ],
      "properties": {
        "projectIdentity": {
          "$ref": "#/$defs/projectDesignIdentity"
        },
        "liveRevision": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "projectDesignInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "path",
        "resourceType",
        "sourceDigest"
      ],
      "properties": {
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "path": {
          "$ref": "#/$defs/resourcePath"
        },
        "resourceType": {
          "$ref": "#/$defs/resourceType"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "projectDesignCanonicalBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sourceDigest",
        "source"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/resourcePath"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "$ref": "#/$defs/canonicalResourceSource"
        }
      }
    },
    "projectDesignBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "resourceType",
        "resourceId",
        "resourceVersion",
        "handle"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/resourcePath"
        },
        "resourceType": {
          "$ref": "#/$defs/resourceType"
        },
        "resourceId": {
          "$ref": "#/$defs/identity"
        },
        "resourceVersion": {
          "$ref": "#/$defs/resourceVersion"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        }
      }
    },
    "projectDesignDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonCodes"
      ],
      "properties": {
        "resourceType": {
          "$ref": "#/$defs/resourceType"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "path": {
          "$ref": "#/$defs/resourcePath"
        },
        "reasonCodes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "projectDesignLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumFileCount",
        "maximumAggregateBytes"
      ],
      "properties": {
        "maximumFileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maximumFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maximumAggregateBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25000000
        }
      }
    },
    "projectDesignContextResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "designContextContractVersion",
        "ok",
        "outcome",
        "result"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "designContextContractVersion": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "outcome": {
          "const": "PROJECT_DESIGN_CONTEXT_READY"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "snapshot",
            "inventory",
            "canonicalBodies",
            "bindings",
            "limits",
            "diagnostics"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/projectDesignProtocol"
            },
            "projectRequirements": {
              "$ref": "#/$defs/projectDesignRequirements"
            },
            "snapshot": {
              "$ref": "#/$defs/projectDesignSnapshot"
            },
            "inventory": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/projectDesignInventoryEntry"
              }
            },
            "canonicalBodies": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/projectDesignCanonicalBody"
              }
            },
            "bindings": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/projectDesignBinding"
              }
            },
            "limits": {
              "$ref": "#/$defs/projectDesignLimits"
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/projectDesignDiagnostic"
              }
            }
          }
        }
      }
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^resources/(?:functions|requests|variables|widgets)/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
    },
    "projectDesignContext": {"$ref": "https://apiease.com/contracts/project-design/v1/schemas/design-context.schema.json"},
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactDigest", "changeSetId", "changeSetDigest"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/identity"},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "changeSetId": {"$ref": "#/$defs/identity"},
        "changeSetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "projectChangeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactContractVersion", "artifactId", "artifactDigest", "projectId", "changeSetId", "changeSetDigest", "changeSet"],
      "properties": {
        "artifactContractVersion": {"const": 1},
        "artifactId": {"$ref": "#/$defs/identity"},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "projectId": {"$ref": "#/$defs/identity"},
        "changeSetId": {"$ref": "#/$defs/identity"},
        "changeSetDigest": {"$ref": "#/$defs/digest"},
        "changeSet": {"$ref": "#/$defs/canonicalResourceChangeSet"}
      }
    },
    "projectProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalContractVersion", "proposalId", "projectId", "artifactBinding", "approvalBindingDigest", "status"],
      "properties": {
        "proposalContractVersion": {"const": 1},
        "proposalId": {"$ref": "#/$defs/identity"},
        "projectId": {"$ref": "#/$defs/identity"},
        "artifactBinding": {"$ref": "#/$defs/artifactBinding"},
        "approvalBindingDigest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["pending", "approved", "rejected", "stale", "cancelled", "applying", "committed", "failed"]}
      }
    },
    "appliedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "operation"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "operation": {"enum": ["create", "update", "delete"]},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"}
      }
    },
    "projectApplyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applyReceiptContractVersion", "receiptId", "operationKey", "projectId", "changeSetId", "changeSetDigest", "replayed", "outcome", "resultingBaseline", "resources"],
      "properties": {
        "applyReceiptContractVersion": {"const": 1},
        "receiptId": {"$ref": "#/$defs/identity"},
        "operationKey": {"$ref": "#/$defs/operationKey"},
        "projectId": {"$ref": "#/$defs/identity"},
        "proposalId": {"$ref": "#/$defs/identity"},
        "artifactBinding": {"$ref": "#/$defs/artifactBinding"},
        "changeSetId": {"$ref": "#/$defs/identity"},
        "changeSetDigest": {"$ref": "#/$defs/digest"},
        "replayed": {"type": "boolean"},
        "outcome": {"enum": ["PROJECT_APPLIED", "PROJECT_APPLY_NO_CHANGE"]},
        "resultingBaseline": {"$ref": "#/$defs/baseline"},
        "resources": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/appliedResource"}}
      }
    },
    "projectValidateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "changeSet"],
      "properties": {"contractVersion": {"const": 1}, "changeSet": {"$ref": "#/$defs/canonicalResourceChangeSet"}}
    },
    "projectPlanRequest": {"$ref": "#/$defs/projectValidateRequest"},
    "projectApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "operationKey", "changeSet"],
      "properties": {
        "contractVersion": {"const": 1},
        "operationKey": {"$ref": "#/$defs/operationKey"},
        "changeSet": {"$ref": "#/$defs/canonicalResourceChangeSet"}
      }
    },
    "projectDeferredSubmissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "operationKey", "artifact"],
      "properties": {
        "contractVersion": {"const": 1},
        "operationKey": {"$ref": "#/$defs/operationKey"},
        "artifact": {"$ref": "#/$defs/projectChangeArtifact"}
      }
    }
  }
}
