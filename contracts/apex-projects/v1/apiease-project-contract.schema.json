        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_BOOTSTRAP_PENDING"},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "retryAfterMilliseconds"],
          "properties": {
            "project": {"$ref": "#/$defs/projectStatus"},
            "retryAfterMilliseconds": {"type": "integer", "minimum": 1, "maximum": 3600000}
          }
        }
      }
    },
