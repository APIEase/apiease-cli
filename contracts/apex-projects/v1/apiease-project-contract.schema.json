            "resourceType": {"$ref": "#/$defs/resourceType"},
            "resourceId": {"$ref": "#/$defs/identity"},
            "handle": {"$ref": "#/$defs/handle"},
            "operation": {"enum": ["create-if-absent", "update"]},
            "resourceVersion": {"$ref": "#/$defs/resourceVersion"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceType", "resourceId", "handle", "operation"],
          "properties": {
            "resourceType": {"$ref": "#/$defs/resourceType"},
            "resourceId": {"$ref": "#/$defs/identity"},
            "handle": {"$ref": "#/$defs/handle"},
            "operation": {"const": "delete"}
          }
        }
      ]
