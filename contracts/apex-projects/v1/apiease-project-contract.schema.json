        "operations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/projectOperation"}},
        "operationDigest": {"$ref": "#/$defs/digest"},
        "summary": {"$ref": "#/$defs/planSummary"}
      }
    },
    "projectPlanReadyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_PLAN_READY"},
        "result": {"$ref": "#/$defs/planResult"}
      }
    },
    "projectPlanNoChangeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_PLAN_NO_CHANGE"},
        "result": {"$ref": "#/$defs/planResult"}
      }
