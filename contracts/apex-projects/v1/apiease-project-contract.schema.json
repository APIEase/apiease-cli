        "resources": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/appliedResource"}}
      }
    },
    "projectAppliedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_APPLIED"},
        "result": {"$ref": "#/$defs/applyReceiptResult"}
      }
    },
    "projectApplyNoChangeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_APPLY_NO_CHANGE"},
        "result": {"$ref": "#/$defs/applyReceiptResult"}
      }
    },
    "projectApplyReplayedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "PROJECT_APPLY_REPLAYED"},
        "result": {"$ref": "#/$defs/applyReceiptResult"}
      }
    },
    "projectErrorCode": {
      "enum": ["INVALID_JSON", "CONTRACT_INVALID", "CONTRACT_VERSION_UNSUPPORTED", "CANDIDATE_FORMAT_VERSION_UNSUPPORTED", "UNAUTHENTICATED", "UNAUTHORIZED", "PROJECT_WORKER_AUTHORITY_UNAVAILABLE", "PROJECT_NOT_FOUND", "METHOD_NOT_ALLOWED", "RESOURCE_ALREADY_EXISTS", "RESOURCE_VERSION_CONFLICT", "PROJECT_BASELINE_CONFLICT", "PROJECT_IDEMPOTENCY_CONFLICT", "PROJECT_PROJECTION_CONFLICT", "PAYLOAD_TOO_LARGE", "PROJECT_FILE_COUNT_EXCEEDED", "PROJECT_FILE_SIZE_EXCEEDED", "PROJECT_AGGREGATE_SIZE_EXCEEDED", "CONTENT_TYPE_UNSUPPORTED", "RESOURCE_VALIDATION_FAILED", "PROJECT_CANDIDATE_INVALID", "PROJECT_DEPENDENCY_INVALID", "PROJECT_SECURE_INPUT_INVALID", "RATE_LIMITED", "PROJECT_PROJECTION_UNAVAILABLE", "SERVICE_UNAVAILABLE"]
    },
    "projectError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "diagnostics"],
      "properties": {
        "code": {"$ref": "#/$defs/projectErrorCode"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "diagnostics": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "projectErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "error"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": false},
        "outcome": {"$ref": "#/$defs/projectErrorCode"},
        "error": {"$ref": "#/$defs/projectError"}
      }
    },
    "conflictResponse": {
      "oneOf": [
        {"$ref": "#/$defs/resourceErrorResponse"},
        {"$ref": "#/$defs/projectErrorResponse"}
      ]
    }
  }
}
