{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apiease.com/contracts/apex-projects/v1/apiease-project-contract.schema.json",
  "title": "APIEase Resource API and Apex Projects contract bundle, version 1",
  "$defs": {
    "contractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applyReceiptVersion", "artifactEnvelopeVersion", "candidateFormatVersion", "localStateVersion", "projectApiContractVersion", "resourceApiContractVersion"],
      "properties": {
        "applyReceiptVersion": {"const": 1},
        "artifactEnvelopeVersion": {"const": 1},
        "candidateFormatVersion": {"const": 1},
        "localStateVersion": {"const": 1},
        "projectApiContractVersion": {"const": 1},
        "resourceApiContractVersion": {"const": 1}
      }
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,1023}$"
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resourceVersion": {
      "type": "string",
      "pattern": "^rv1_[A-Za-z0-9_-]{43}$"
    },
    "projectApiMethod": {"const": "POST"},
    "projectApiEndpoint": {
      "enum": [
        "/api/v1/projects/apply",
        "/api/v1/projects/bootstrap",
        "/api/v1/projects/plan",
        "/api/v1/projects/validate"
      ]
    },
    "operationKind": {"enum": ["create-if-absent", "delete", "update"]},
    "authorizationMode": {"enum": ["personal", "worker"]},
    "contentEncoding": {"const": "utf-8"},
    "terminalOutcome": {
      "enum": [
        "PROJECT_APPLIED",
        "PROJECT_APPLY_NO_CHANGE",
        "PROJECT_APPLY_REPLAYED",
        "PROJECT_BOOTSTRAP_PENDING",
        "PROJECT_BOOTSTRAP_SYNCHRONIZED",
        "PROJECT_BOOTSTRAP_SYNCHRONIZED_NO_RESOURCES",
        "PROJECT_PLAN_NO_CHANGE",
        "PROJECT_PLAN_READY",
        "PROJECT_VALID",
        "RESOURCE_CREATED",
        "RESOURCE_DELETED",
        "RESOURCE_LISTED",
        "RESOURCE_NO_CHANGE",
        "RESOURCE_READ",
        "RESOURCE_UPDATED"
      ]
    },
    "errorCode": {
      "enum": [
        "CANDIDATE_FORMAT_VERSION_UNSUPPORTED",
        "CONTENT_TYPE_UNSUPPORTED",
        "CONTRACT_INVALID",
        "CONTRACT_VERSION_UNSUPPORTED",
        "INVALID_JSON",
        "METHOD_NOT_ALLOWED",
        "PAYLOAD_TOO_LARGE",
        "PROJECT_AGGREGATE_SIZE_EXCEEDED",
        "PROJECT_BASELINE_CONFLICT",
        "PROJECT_CANDIDATE_INVALID",
        "PROJECT_DEPENDENCY_INVALID",
        "PROJECT_FILE_COUNT_EXCEEDED",
        "PROJECT_FILE_SIZE_EXCEEDED",
        "PROJECT_IDEMPOTENCY_CONFLICT",
        "PROJECT_NOT_FOUND",
        "PROJECT_PROJECTION_CONFLICT",
        "PROJECT_PROJECTION_UNAVAILABLE",
        "PROJECT_SECURE_INPUT_INVALID",
        "PROJECT_WORKER_AUTHORITY_UNAVAILABLE",
        "RATE_LIMITED",
        "RESOURCE_ALREADY_EXISTS",
        "RESOURCE_NOT_FOUND",
        "RESOURCE_VALIDATION_FAILED",
        "RESOURCE_VERSION_CONFLICT",
        "SERVICE_UNAVAILABLE",
        "UNAUTHENTICATED",
        "UNAUTHORIZED"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "resourceType": {
      "enum": ["function", "request", "variable", "widget"]
    },
    "projectResourceType": {
      "enum": ["request", "variable"]
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "boundedString": {
      "type": "string",
      "maxLength": 65536
    },
    "shortString": {
      "type": "string",
      "maxLength": 1024
    },
    "nullableShortString": {
      "type": ["string", "null"],
      "maxLength": 1024
    },
    "managedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\.apiease/project\\.json|resources/(?:functions|requests|variables|widgets)/[a-z0-9]+(?:-[a-z0-9]+)*\\.json)$"
    },
    "resourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^resources/(?:functions|requests|variables|widgets)/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveRevision", "snapshotDigest"],
      "properties": {
        "liveRevision": {"$ref": "#/$defs/nonnegativeInteger"},
        "snapshotDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "publicTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository", "ref"],
      "properties": {
        "owner": {"const": "APIEase"},
        "repository": {"const": "apiease-template"},
        "ref": {"const": "main"}
      }
    },
    "protectedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"const": "preserve"}
      }
    },
    "requestParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sensitive", "value"],
      "properties": {
        "type": {"$ref": "#/$defs/shortString"},
        "name": {"$ref": "#/$defs/shortString"},
        "sensitive": {"type": "boolean"},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/boundedString"},
            {"$ref": "#/$defs/protectedValue"}
          ]
        }
      }
    },
    "requestTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cron"],
          "properties": {
            "type": {"const": "cron"},
            "cron": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {"value": {"$ref": "#/$defs/shortString"}}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "proxyEndpoint"],
          "properties": {
            "type": {"const": "proxyEndpoint"},
            "proxyEndpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "method", "authenticated"],
              "properties": {
                "path": {"$ref": "#/$defs/shortString"},
                "method": {"$ref": "#/$defs/shortString"},
                "authenticated": {"type": "boolean"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "storefrontAppProxy"],
          "properties": {
            "type": {"const": "storefrontAppProxy"},
            "storefrontAppProxy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sensitiveRequest": {"type": "boolean"},
                "sensitiveResponse": {"type": "boolean"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "webhook"],
          "properties": {
            "type": {"const": "webhook"},
            "webhook": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event"],
              "properties": {"event": {"$ref": "#/$defs/shortString"}}
            }
          }
        }
      ]
    },
    "functionParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/shortString"},
        "description": {"$ref": "#/$defs/boundedString"},
        "type": {"$ref": "#/$defs/shortString"}
      }
    },
    "canonicalRequestSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "formatVersion", "resourceType", "handle", "name", "type", "parameters", "triggers"],
      "properties": {
        "contractVersion": {"const": 1},
        "formatVersion": {"const": 1},
        "resourceType": {"const": "request"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "type": {"$ref": "#/$defs/shortString"},
        "method": {"$ref": "#/$defs/shortString"},
        "address": {"$ref": "#/$defs/boundedString"},
        "liquid": {"$ref": "#/$defs/boundedString"},
        "parameters": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/requestParameter"}},
        "triggers": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/requestTrigger"}},
        "nextRequestHandle": {"$ref": "#/$defs/handle"}
      }
    },
    "canonicalWidgetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "formatVersion", "resourceType", "handle", "name", "liquid", "javascript", "externalJavascriptUrls", "disableJavascript"],
      "properties": {
        "contractVersion": {"const": 1},
        "formatVersion": {"const": 1},
        "resourceType": {"const": "widget"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "liquid": {"$ref": "#/$defs/boundedString"},
        "javascript": {"$ref": "#/$defs/boundedString"},
        "externalJavascriptUrls": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/boundedString"}},
        "disableJavascript": {"type": "boolean"}
      }
    },
    "canonicalVariableSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "formatVersion", "resourceType", "handle", "name", "sensitive", "value"],
      "properties": {
        "contractVersion": {"const": 1},
        "formatVersion": {"const": 1},
        "resourceType": {"const": "variable"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "sensitive": {"type": "boolean"},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/boundedString"},
            {"$ref": "#/$defs/protectedValue"}
          ]
        }
      }
    },
    "canonicalFunctionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "formatVersion", "resourceType", "handle", "name", "description", "type", "liquid", "parameters"],
      "properties": {
        "contractVersion": {"const": 1},
        "formatVersion": {"const": 1},
        "resourceType": {"const": "function"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "description": {"$ref": "#/$defs/boundedString"},
        "type": {"$ref": "#/$defs/shortString"},
        "liquid": {"$ref": "#/$defs/boundedString"},
        "parameters": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/functionParameter"}}
      }
    },
    "canonicalResourceSource": {
      "oneOf": [
        {"$ref": "#/$defs/canonicalRequestSource"},
        {"$ref": "#/$defs/canonicalWidgetSource"},
        {"$ref": "#/$defs/canonicalVariableSource"},
        {"$ref": "#/$defs/canonicalFunctionSource"}
      ]
    },
    "resourceRequestParameterInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["path", "query", "header", "body", "flow", "liquid", "system"]},
        "name": {"$ref": "#/$defs/shortString"},
        "value": {"$ref": "#/$defs/boundedString"},
        "sensitive": {"type": "boolean"}
      }
    },
    "resourceRequestDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "type": {"enum": ["http", "flow", "liquid", "system"]},
        "method": {"type": "string", "minLength": 1, "maxLength": 1024},
        "address": {"type": "string", "minLength": 1, "maxLength": 65536},
        "liquid": {"type": "string", "minLength": 1, "maxLength": 1000000},
        "nextRequest": {"$ref": "#/$defs/shortString"},
        "parameters": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/resourceRequestParameterInput"}},
        "triggers": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/requestTrigger"}}
      }
    },
    "resourceWidgetDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "name", "liquid"],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "liquid": {"type": "string", "minLength": 1, "maxLength": 1000000},
        "javascript": {"type": "string", "maxLength": 1000000},
        "externalJavascriptUrls": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/boundedString"}},
        "disableJavascript": {"type": "boolean"}
      }
    },
    "resourceVariableDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sensitive"],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "value": {"$ref": "#/$defs/boundedString"},
        "sensitive": {"type": "boolean"},
        "displayValue": {"$ref": "#/$defs/boundedString"}
      }
    },
    "resourceFunctionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "liquid"],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "description": {"$ref": "#/$defs/boundedString"},
        "type": {"const": "liquid"},
        "liquid": {"type": "string", "minLength": 1, "maxLength": 1000000},
        "parameters": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 1024},
              "description": {"$ref": "#/$defs/boundedString"},
              "type": {"enum": ["string", "number", "boolean", "object", "array"]}
            }
          }
        }
      }
    },
    "resourceDraft": {
      "anyOf": [
        {"$ref": "#/$defs/resourceRequestDraft"},
        {"$ref": "#/$defs/resourceWidgetDraft"},
        {"$ref": "#/$defs/resourceVariableDraft"},
        {"$ref": "#/$defs/resourceFunctionDraft"}
      ]
    },
    "editableRequestParameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "sensitive", "value"],
          "properties": {
            "id": {"$ref": "#/$defs/identity"},
            "type": {"enum": ["path", "query", "header", "body", "flow", "liquid", "system"]},
            "name": {"$ref": "#/$defs/shortString"},
            "sensitive": {"const": false},
            "value": {"$ref": "#/$defs/boundedString"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "sensitive", "displayValue"],
          "properties": {
            "id": {"$ref": "#/$defs/identity"},
            "type": {"enum": ["path", "query", "header", "body", "flow", "liquid", "system"]},
            "name": {"$ref": "#/$defs/shortString"},
            "sensitive": {"const": true},
            "displayValue": {"$ref": "#/$defs/boundedString"}
          }
        }
      ]
    },
    "editableRequestTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "type": {"enum": ["webhook", "cron", "proxyEndpoint", "storefrontAppProxy"]},
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {"event": {"$ref": "#/$defs/shortString"}}
        },
        "cron": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {"value": {"$ref": "#/$defs/shortString"}}
        },
        "proxyEndpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "method", "authenticated"],
          "properties": {
            "path": {"$ref": "#/$defs/shortString"},
            "method": {"$ref": "#/$defs/shortString"},
            "authenticated": {"type": "boolean"}
          }
        },
        "storefrontAppProxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systemGenerated": {"type": "boolean"},
            "systemGeneratedAt": {"$ref": "#/$defs/shortString"},
            "systemGeneratedReason": {"$ref": "#/$defs/shortString"},
            "sensitiveRequest": {"type": "boolean"},
            "sensitiveResponse": {"type": "boolean"}
          }
        }
      }
    },
    "editableRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceVersion", "handle", "name", "type", "method", "address", "liquid", "nextRequest", "parameters", "triggers"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "type": {"enum": ["http", "flow", "liquid", "system"]},
        "method": {"$ref": "#/$defs/shortString"},
        "address": {"$ref": "#/$defs/boundedString"},
        "liquid": {"$ref": "#/$defs/boundedString"},
        "nextRequest": {"$ref": "#/$defs/shortString"},
        "parameters": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/editableRequestParameter"}},
        "triggers": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/editableRequestTrigger"}}
      }
    },
    "editableWidget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceVersion", "handle", "name", "liquid", "javascript", "externalJavascriptUrls", "disableJavascript"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "liquid": {"$ref": "#/$defs/boundedString"},
        "javascript": {"$ref": "#/$defs/boundedString"},
        "externalJavascriptUrls": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/boundedString"}},
        "disableJavascript": {"type": "boolean"}
      }
    },
    "editableVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceVersion", "handle", "name", "sensitive", "value", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "sensitive": {"type": "boolean"},
        "value": {"oneOf": [{"$ref": "#/$defs/boundedString"}, {"$ref": "#/$defs/protectedValue"}]},
        "displayValue": {"$ref": "#/$defs/boundedString"},
        "createdAt": {"type": ["string", "null"], "maxLength": 1024},
        "updatedAt": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "editableFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceVersion", "handle", "name", "description", "type", "liquid", "parameters", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "handle": {"$ref": "#/$defs/handle"},
        "name": {"$ref": "#/$defs/shortString"},
        "description": {"$ref": "#/$defs/boundedString"},
        "type": {"const": "liquid"},
        "liquid": {"$ref": "#/$defs/boundedString"},
        "parameters": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/functionParameter"}},
        "createdAt": {"type": ["string", "null"], "maxLength": 1024},
        "updatedAt": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "editableResource": {
      "oneOf": [
        {"$ref": "#/$defs/editableRequest"},
        {"$ref": "#/$defs/editableWidget"},
        {"$ref": "#/$defs/editableVariable"},
        {"$ref": "#/$defs/editableFunction"}
      ]
    },
    "resourceCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "operation", "resource"],
      "properties": {
        "contractVersion": {"const": 1},
        "operation": {"const": "create-if-absent"},
        "resource": {"$ref": "#/$defs/resourceDraft"}
      }
    },
    "resourceUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "expectedResourceVersion", "resource"],
      "properties": {
        "contractVersion": {"const": 1},
        "expectedResourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "resource": {"$ref": "#/$defs/resourceDraft"}
      }
    },
    "resourceDeleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "expectedResourceVersion"],
      "properties": {
        "contractVersion": {"const": 1},
        "expectedResourceVersion": {"$ref": "#/$defs/resourceVersion"}
      }
    },
    "resourceReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resource"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "resource": {"$ref": "#/$defs/editableResource"}
      }
    },
    "resourceListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resources"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "resources": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/editableResource"}}
      }
    },
    "resourceMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resource", "resourceVersion"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "resource": {"$ref": "#/$defs/editableResource"},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "liveRevision": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "resourceDeleteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "id", "handle"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "id": {"$ref": "#/$defs/identity"},
        "handle": {"$ref": "#/$defs/handle"},
        "resourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "liveRevision": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "resourceReadResponse": {
      "$ref": "#/$defs/resourceSuccessEnvelopeRead"
    },
    "resourceSuccessEnvelopeRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "RESOURCE_READ"},
        "result": {"$ref": "#/$defs/resourceReadResult"}
      }
    },
    "resourceListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "RESOURCE_LISTED"},
        "result": {"$ref": "#/$defs/resourceListResult"}
      }
    },
    "resourceMutationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"enum": ["RESOURCE_CREATED", "RESOURCE_UPDATED", "RESOURCE_NO_CHANGE"]},
        "result": {"$ref": "#/$defs/resourceMutationResult"}
      }
    },
    "resourceDeleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": true},
        "outcome": {"const": "RESOURCE_DELETED"},
        "result": {"$ref": "#/$defs/resourceDeleteResult"}
      }
    },
    "fieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "message"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "code": {"type": "string", "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "conflictDetail": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "id": {"$ref": "#/$defs/identity"},
        "handle": {"$ref": "#/$defs/handle"},
        "expectedResourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "currentResourceVersion": {"$ref": "#/$defs/resourceVersion"},
        "path": {"$ref": "#/$defs/shortString"},
        "fieldPath": {"$ref": "#/$defs/shortString"},
        "operationIndex": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "resourceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["INVALID_JSON", "CONTRACT_INVALID", "CONTRACT_VERSION_UNSUPPORTED", "UNAUTHENTICATED", "UNAUTHORIZED", "RESOURCE_NOT_FOUND", "METHOD_NOT_ALLOWED", "RESOURCE_ALREADY_EXISTS", "RESOURCE_VERSION_CONFLICT", "PAYLOAD_TOO_LARGE", "CONTENT_TYPE_UNSUPPORTED", "RESOURCE_VALIDATION_FAILED", "SERVICE_UNAVAILABLE"]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 256},
        "fieldErrors": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/fieldError"}},
        "details": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/conflictDetail"}}
      }
    },
    "resourceErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "error"],
      "properties": {
        "contractVersion": {"const": 1},
        "ok": {"const": false},
        "outcome": {"$ref": "#/$defs/resourceErrorCode"},
        "error": {"$ref": "#/$defs/resourceError"}
      }
    },
    "resourceErrorCode": {
      "enum": ["INVALID_JSON", "CONTRACT_INVALID", "CONTRACT_VERSION_UNSUPPORTED", "UNAUTHENTICATED", "UNAUTHORIZED", "RESOURCE_NOT_FOUND", "METHOD_NOT_ALLOWED", "RESOURCE_ALREADY_EXISTS", "RESOURCE_VERSION_CONFLICT", "PAYLOAD_TOO_LARGE", "CONTENT_TYPE_UNSUPPORTED", "RESOURCE_VALIDATION_FAILED", "SERVICE_UNAVAILABLE"]
    },
    "managedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "encoding", "content", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/managedPath"},
        "encoding": {"$ref": "#/$defs/contentEncoding"},
        "content": {"type": "string", "maxLength": 1000000},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "metadataManagedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "encoding", "content", "digest"],
      "properties": {
        "path": {"const": ".apiease/project.json"},
        "encoding": {"$ref": "#/$defs/contentEncoding"},
        "content": {"type": "string", "maxLength": 1000000},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "resourceType", "resourceId", "originalHandle", "expectedResourceVersion"],
      "properties": {
        "path": {"$ref": "#/$defs/resourcePath"},
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "resourceId": {"$ref": "#/$defs/identity"},
        "originalHandle": {"$ref": "#/$defs/handle"},
        "expectedResourceVersion": {"$ref": "#/$defs/resourceVersion"}
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "originalHandle", "expectedResourceVersion"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/resourceType"},
        "resourceId": {"$ref": "#/$defs/identity"},
        "originalHandle": {"$ref": "#/$defs/handle"},
        "expectedResourceVersion": {"$ref": "#/$defs/resourceVersion"}
      }
    },
    "secureInputPreserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "fieldPath", "mode"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/projectResourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "fieldPath": {"$ref": "#/$defs/protectedFieldPath"},
        "mode": {"const": "preserve"}
      }
    },
    "secureInputReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "fieldPath", "mode", "value"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/projectResourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "fieldPath": {"$ref": "#/$defs/protectedFieldPath"},
        "mode": {"const": "replace"},
        "value": {"$ref": "#/$defs/boundedString"}
      }
    },
    "secureInputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "handle", "fieldPath", "mode", "sourceResourceType", "sourceResourceId", "sourceFieldPath", "sourceExpectedResourceVersion"],
      "properties": {
        "resourceType": {"$ref": "#/$defs/projectResourceType"},
        "handle": {"$ref": "#/$defs/handle"},
        "fieldPath": {"$ref": "#/$defs/protectedFieldPath"},
        "mode": {"const": "reference"},
        "sourceResourceType": {"$ref": "#/$defs/projectResourceType"},
        "sourceResourceId": {"$ref": "#/$defs/identity"},
        "sourceFieldPath": {"$ref": "#/$defs/protectedFieldPath"},
        "sourceExpectedResourceVersion": {"$ref": "#/$defs/resourceVersion"}
      }
    },
    "protectedFieldPath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?:value|parameters\\.[^.]+\\.value)$"
    },
    "secureInput": {
      "oneOf": [
        {"$ref": "#/$defs/secureInputPreserve"},
        {"$ref": "#/$defs/secureInputReplace"},
        {"$ref": "#/$defs/secureInputReference"}
      ]
    },
    "projectCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateFormatVersion", "baseline", "files", "resourceBindings", "deletions", "secureInputs"],
      "properties": {
        "candidateFormatVersion": {"const": 1},
        "baseline": {"$ref": "#/$defs/baseline"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/managedFile"},
          "contains": {"$ref": "#/$defs/metadataManagedFile"},
          "minContains": 1,
          "maxContains": 1
        },
        "resourceBindings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/resourceBinding"}},
        "deletions": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/deletion"}},
        "secureInputs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/secureInput"}}
      }
    },
    "projectBootstrapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion"],
      "properties": {
        "contractVersion": {"const": 1},
        "wakeProjection": {"type": "boolean", "default": false}
      }
    },
    "projectStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synchronized"],
      "properties": {
        "errorClassification": {"$ref": "#/$defs/nullableShortString"},
        "lifecycle": {"$ref": "#/$defs/nullableShortString"},
        "liveRevision": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "projectId": {"oneOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
        "projectedRevision": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "repositoryState": {"$ref": "#/$defs/nullableShortString"},
        "repositoryVerified": {"type": ["boolean", "null"]},
        "synchronized": {"const": false}
      }
    },
    "projectBootstrapPendingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "ok", "outcome", "result"],
