    "projectApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "operationKey", "authorityMode", "candidate", "operations"],
      "properties": {
        "contractVersion": {"const": 1},
        "operationKey": {"$ref": "#/$defs/operationKey"},
        "authorityMode": {"$ref": "#/$defs/authorizationMode"},
        "candidate": {"$ref": "#/$defs/projectCandidate"},
        "operations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/projectOperation"}}
      }
    },
    "appliedResource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceType", "resourceId", "handle", "operation", "resourceVersion"],
